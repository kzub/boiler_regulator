# The Arduino controller is reachable only from the server/container.
CONTROLLER_BASE_URL=http://192.168.88.20
CONTROLLER_TIMEOUT_MS=20000
PORT=8080
# Local-only mode: HOST=127.0.0.1. Docker uses 0.0.0.0 inside its container.
HOST=0.0.0.0
STATUS_POLL_INTERVAL_MS=5000
MOTION_POLL_INTERVAL_MS=300
MOTION_TIMEOUT_MS=30000
AUTO_CALIBRATE=true
CALIBRATION_DATA_PATH=/data/calibration.json
